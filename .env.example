# Copy to .env.local and fill in. Never commit .env.local.

# AI (OpenRouter)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash

# ---- Sending a case to the advocate (needed in production) ----
# Email: any SMTP account. For Gmail, turn on 2-step verification, create an "App password",
# and use smtp.gmail.com / 587 with the Gmail address and that app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# MAIL_FROM="Hisaab <you@example.com>"

# Storage: a free Upstash Redis database (add it from Vercel's Marketplace; it fills these in for you).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The advocate's approval page at /advocate
ADVOCATE_PASSPHRASE=
SESSION_SECRET=
